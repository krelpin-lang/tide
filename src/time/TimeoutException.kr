package tide.time;

import std.lang.Exception;

/**
 * Exception thrown when an operation enclosed within a {@link Timeout} future
 * fails to complete before the specified duration expires.
 */
final class TimeoutException extends Exception {
    /**
     * Constructs a TimeoutException with the specified message.
     *
     * @param message Detail message.
     */
    TimeoutException(String message) {
        super(message);
    }
}
