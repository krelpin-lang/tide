package tide.runtime;

import std.function.Supplier;
import std.io.IOException;
import std.lang.AutoCloseable;
import std.lang.IllegalStateException;
import std.lang.Thread;
import std.net.Poller;
import std.net.TcpListener;
import std.net.TcpStream;
import std.net.UdpSocket;
import std.sync.AtomicInt;
import std.sync.Mutex;
import std.task.Context;
import std.task.Future;
import std.task.Poll;
import std.task.Waker;
import std.time.Instant;
import std.util.ArrayList;
import std.util.HashMap;
import std.util.List;
import std.util.Map;
import tide.reactor.Reactor;

/**
 * Asynchronous execution runtime managing thread worker pools, reactor I/O polling,
 * timer wheel events, and task scheduling.
 * Implements {@link AutoCloseable} for automatic graceful shutdown when dropped or closed.
 */
final class Runtime implements AutoCloseable {
    private static final AtomicInt NEXT_RUNTIME_ID = new AtomicInt(1);
    private static final Mutex<Map<int, Engine>> ENGINES = new Mutex<>(new HashMap<>());

    private final int id;
    private final int threads;
    private final String threadName;
    private final Handle handle;
    private final List<Thread> workers;
    private final List<Thread> blockingWorkers;
    private boolean shutdown;

    private Runtime(
        int id,
        int threads,
        String threadName
    ) {
        this.id = id;
        this.threads = threads;
        this.threadName = threadName;
        this.handle = new Handle(id);
        this.workers = new ArrayList<>();
        this.blockingWorkers = new ArrayList<>();
        this.shutdown = false;
    }

    /**
     * Creates a new Runtime with default configuration.
     *
     * @return A newly initialized Runtime instance.
     * @throws IOException If initializing reactor I/O fails.
     */
    static Runtime create() throws IOException {
        return Runtime.create(Config.DEFAULT);
    }

    /**
     * Creates a new Runtime configured with the specified options.
     *
     * @param config The runtime configuration options.
     * @return A newly initialized Runtime instance.
     * @throws IOException If initializing reactor I/O fails.
     */
    static Runtime create(Config config) throws IOException {
        int id = Runtime.NEXT_RUNTIME_ID.increment();
        Reactor? reactor = null;
        TcpStream? wakeWriter = null;
        if (config.enableIo()) {
            Poller poller = Poller.create();
            TcpListener listener = TcpListener.bind("127.0.0.1:0");
            String addr = listener.localAddr().toString();
            TcpStream writer = TcpStream.connect(addr);
            TcpStream reader = listener.accept();
            writer.setNonBlocking(true);
            reactor = Reactor.createWithReader(poller, reader);
            wakeWriter = writer;
        }

        Engine engine = new Engine(id, config.enableTimer(), config.enableIo(), reactor, wakeWriter);
        {
            Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
            guard.getMut().put(id, engine);
        }

        Runtime runtime = new Runtime(id, config.threads(), config.threadName());
        if (config.threads() > 1) {
            runtime.startWorkers(config.threads());
        }
        if (config.blockingThreads() > 0) {
            runtime.startBlockingWorkers(config.blockingThreads());
        }
        return runtime;
    }

    /**
     * Starts the background blocking worker threads.
     *
     * @param count Number of blocking threads to spawn.
     */
    private mut void startBlockingWorkers(int count) {
        int runtimeId = this.id;
        for (int i = 0; i < count; i++) {
            Thread worker = new Thread(move () -> Runtime.runBlockingWorker(runtimeId));
            worker.start();
            this.blockingWorkers.add(worker);
        }
    }

    /**
     * Main execution loop for blocking pool worker threads.
     *
     * @param runtimeId Owning runtime identifier.
     */
    private static void runBlockingWorker(int runtimeId) {
        try {
            while (!Runtime.isShutdown(runtimeId)) {
                BlockingPool.TaskRunner? task = Runtime.takeBlockingTask(runtimeId);
                if (task != null) {
                    task.run();
                } else {
                    Thread.sleep(1L);
                }
            }
        } finally {}
    }

    /**
     * Starts the asynchronous cooperative worker threads.
     *
     * @param count Number of worker threads to spawn.
     */
    private mut void startWorkers(int count) {
        int runtimeId = this.id;
        for (int i = 0; i < count; i++) {
            Thread worker = new Thread(move () -> Runtime.runWorker(runtimeId));
            worker.start();
            this.workers.add(worker);
        }
    }

    /**
     * Main cooperative scheduling loop for asynchronous worker threads.
     *
     * @param runtimeId Owning runtime identifier.
     */
    private static void runWorker(int runtimeId) {
        Handle.setCurrent(new Handle(runtimeId));
        try {
            while (!Runtime.isShutdown(runtimeId)) {
                long taskId = Runtime.takeReadyTask(runtimeId, 0L);
                if (taskId > 0L) {
                    Runtime.pollTask(runtimeId, taskId);
                } else {
                    Thread.sleep(1L);
                }
            }
        } finally {
            Handle.clearCurrent();
        }
    }

    /**
     * Convenience method to execute a future on a temporary runtime until completion.
     *
     * @param future The root future to execute.
     * @return The completed future's return value.
     * @throws Exception If execution fails with an uncaught exception.
     */
    static <T> T execute(Future<T> future) throws Exception {
        Runtime runtime = Runtime.create();
        try {
            return runtime.blockOn(future);
        } finally {
            runtime.shutdown();
        }
    }

    /**
     * Executes a future on a temporary runtime configured with custom settings.
     *
     * @param config Custom configuration.
     * @param future The root future to execute.
     * @return The completed future's return value.
     * @throws Exception If execution fails with an uncaught exception.
     */
    static <T> T execute(Config config, Future<T> future) throws Exception {
        Runtime runtime = Runtime.create(config);
        try {
            return runtime.blockOn(future);
        } finally {
            runtime.shutdown();
        }
    }

    /**
     * Spawns a detached task onto the ambient runtime of the calling thread.
     *
     * @param future The future to schedule.
     * @return A JoinHandle to await the result or abort.
     */
    static <T> JoinHandle<T> spawnDetached(Future<T> future) keeps future {
        return Runtime.spawnTask(Handle.current().id(), future);
    }

    /**
     * Spawns a detached blocking task onto the ambient runtime's blocking pool.
     *
     * @param action The blocking action to execute.
     * @return A JoinHandle to await the result or abort.
     */
    static <T> JoinHandle<T> spawnBlockingDetached(BlockingAction<T> action) keeps action {
        return Runtime.spawnBlockingTask(Handle.current().id(), action);
    }

    /**
     * Creates a future that cooperatively yields execution back to the scheduler.
     *
     * @return A yield future.
     */
    static YieldNow yieldNow() {
        return new YieldNow();
    }

    /**
     * Returns the unique identifier of this runtime instance.
     *
     * @return Unique integer ID.
     */
    int id() {
        return this.id;
    }

    /**
     * Returns the number of worker threads configured for this runtime.
     *
     * @return Configured worker thread count.
     */
    int threads() {
        return this.threads;
    }

    /**
     * Returns the base thread name prefix used for worker threads.
     *
     * @return Worker thread name prefix.
     */
    String threadName() {
        return this.threadName;
    }

    /**
     * Returns the lightweight Handle referencing this runtime instance.
     *
     * @return Handle pointing to this runtime.
     */
    Handle handle() {
        return this.handle;
    }

    /**
     * Captures a snapshot of the runtime metrics for this runtime.
     *
     * @return Snapshot containing active tasks, completed tasks, and queue depths.
     */
    tide.metrics.RuntimeMetrics metrics() {
        return Runtime.metrics(this.id);
    }

    /**
     * Spawns a detached task on the ambient runtime.
     *
     * @param future The future to spawn.
     * @return JoinHandle for the task.
     */
    static <T> JoinHandle<T> spawn(Future<T> future) keeps future {
        return Runtime.spawnDetached(future);
    }

    /**
     * Spawns a blocking action on the ambient runtime's blocking pool.
     *
     * @param action The blocking action to spawn.
     * @return JoinHandle for the task.
     */
    static <T> JoinHandle<T> spawnBlocking(BlockingAction<T> action) keeps action {
        return Runtime.spawnBlockingDetached(action);
    }

    /**
     * Blocks the calling thread, driving the runtime event loop until the given future completes.
     *
     * @param future The root future to execute.
     * @return The resolved return value of the future.
     * @throws Exception If the future completes with an error.
     */
    mut <T> T blockOn(Future<T> future) throws Exception {
        Handle.setCurrent(this.handle);
        boolean pollRoot = true;
        try {
            while (true) {
                if (pollRoot) {
                    pollRoot = false;
                    Context cx = new Context(new Engine.TaskWaker(this.handle, -1L));
                    Poll<T> poll = future.poll(&mut cx);
                    switch (poll) {
                        case Ready(T value) -> {
                            return value;
                        }
                        case Pending -> {}
                    }
                }

                if (this.threads == 1) {
                    int budget = 64;
                    while (budget > 0) {
                        long taskId = Runtime.takeReadyTask(this.id, 0L);
                        if (taskId == 0L) {
                            break;
                        }
                        Runtime.pollTask(this.id, taskId);
                        budget--;
                    }
                }

                if (Runtime.takeRootWoken(this.id)) {
                    pollRoot = true;
                }

                if (pollRoot) {
                    continue;
                }

                Runtime.pollTimers(this.id, Instant.now());

                if (Runtime.takeRootWoken(this.id)) {
                    pollRoot = true;
                    continue;
                }

                Runtime.pollReactor(this.id, 0L);

                if (Runtime.takeRootWoken(this.id)) {
                    pollRoot = true;
                    continue;
                }

                if (!Runtime.hasReadyTasks(this.id) && !Runtime.isRootWoken(this.id)) {
                    Thread.sleep(1L);
                }

                if (Runtime.takeRootWoken(this.id)) {
                    pollRoot = true;
                }
            }
        } finally {
            Handle.clearCurrent();
        }
    }

    /**
     * Computes the maximum poll timeout in milliseconds based on root waker and timer deadlines.
     *
     * @return Timeout duration in milliseconds, or -1 for infinite blocking.
     */
    private long computeTimeout() {
        if (Runtime.isRootWoken(this.id)) {
            return 0L;
        }
        if (this.threads == 1 && Runtime.hasReadyTasks(this.id)) {
            return 0L;
        }
        Instant? next = Runtime.nextTimerDeadline(this.id);
        if (next != null) {
            long diff = next.toEpochMilli() - Instant.now().toEpochMilli();
            return diff < 0L ? 0L : diff;
        }
        return this.threads > 1 ? 20L : -1L;
    }

    /**
     * Initiates graceful shutdown of this runtime, stopping workers, timer wheel,
     * reactor polling, and releasing resources.
     */
    mut void shutdown() {
        if (this.shutdown) {
            return;
        }
        this.shutdown = true;
        int runtimeId = this.id;
        Engine? engine = null;
        {
            Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
            engine = guard.getMut().remove(&runtimeId);
        }
        if (engine != null) {
            engine.shutdown();
        }
        for (int i = 0; i < this.workers.size(); i++) {
            &mut Thread worker = this.workers.getMut(i);
            worker.join();
        }
        this.workers.clear();
        for (int i = 0; i < this.blockingWorkers.size(); i++) {
            &mut Thread worker = this.blockingWorkers.getMut(i);
            worker.join();
        }
        this.blockingWorkers.clear();
    }

    /**
     * Implements AutoCloseable, invoking {@link #shutdown()}.
     */
    @Override
    mut void close() {
        this.shutdown();
    }

    /**
     * Checks whether this runtime has been shut down.
     *
     * @return {@code true} if shut down; {@code false} otherwise.
     */
    boolean isShutdown() {
        return this.shutdown;
    }

    /**
     * Spawns a future on the specified runtime engine.
     *
     * @param <T> Return value type.
     * @param runtimeId Target runtime id.
     * @param future Future to execute.
     * @return JoinHandle for the task.
     */
    static <T> JoinHandle<T> spawnTask(int runtimeId, Future<T> future) keeps future {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            throw new IllegalStateException("Runtime is shut down");
        }
        return engine.spawn(new Handle(runtimeId), future);
    }

    /**
     * Spawns a blocking action on the specified runtime's dedicated pool.
     *
     * @param <T> Return value type.
     * @param runtimeId Target runtime id.
     * @param action Blocking action to run.
     * @return JoinHandle for the task.
     */
    static <T> JoinHandle<T> spawnBlockingTask(int runtimeId, BlockingAction<T> action) keeps action {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            throw new IllegalStateException("Runtime is shut down");
        }
        return engine.spawnBlocking(new Handle(runtimeId), action);
    }

    /**
     * Returns a snapshot of runtime metrics for the specified runtime.
     *
     * @param runtimeId Target runtime id.
     * @return RuntimeMetrics snapshot.
     */
    static tide.metrics.RuntimeMetrics metrics(int runtimeId) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            throw new IllegalStateException("Runtime is shut down");
        }
        return engine.metrics();
    }

    /**
     * Wakes a scheduled task on the target runtime.
     *
     * @param runtimeId Target runtime id.
     * @param taskId Task identifier.
     */
    static void wakeTask(int runtimeId, long taskId) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine != null) {
            engine.wakeTask(taskId);
        }
    }

    /**
     * Completes a task with a successful value.
     *
     * @param runtimeId Target runtime id.
     * @param taskId Task identifier.
     * @param value Resolved value.
     */
    static void finishTask(int runtimeId, long taskId, Object? value) {
        Waker? waker = null;
        {
            Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
            (&Engine)? engine = guard.get().get(&runtimeId);
            if (engine != null) {
                waker = engine.finishTask(taskId, value);
            }
        }
        if (waker != null) {
            waker.wake();
        }
    }

    /**
     * Completes a task with a failure exception.
     *
     * @param runtimeId Target runtime id.
     * @param taskId Task identifier.
     * @param e Exception thrown by task.
     */
    static void failTask(int runtimeId, long taskId, Exception e) {
        Waker? waker = null;
        {
            Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
            (&Engine)? engine = guard.get().get(&runtimeId);
            if (engine != null) {
                waker = engine.failTask(taskId, e);
            }
        }
        if (waker != null) {
            waker.wake();
        }
    }

    /**
     * Aborts an active task.
     *
     * @param runtimeId Target runtime id.
     * @param taskId Task identifier.
     */
    static void abortTask(int runtimeId, long taskId) {
        Waker? waker = null;
        {
            Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
            (&Engine)? engine = guard.get().get(&runtimeId);
            if (engine != null) {
                waker = engine.abortTask(taskId);
            }
        }
        if (waker != null) {
            waker.wake();
        }
    }

    /**
     * Checks if a task has finished executing.
     *
     * @param runtimeId Target runtime id.
     * @param taskId Task identifier.
     * @return {@code true} if finished; {@code false} otherwise.
     */
    static boolean isTaskFinished(int runtimeId, long taskId) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        return engine != null && engine.isTaskFinished(taskId);
    }

    /**
     * Polls completion of a join handle.
     *
     * @param <T> Return type.
     * @param runtimeId Target runtime id.
     * @param taskId Task identifier.
     * @param waker Joining caller waker.
     * @return Ready with return value; Pending otherwise.
     * @throws Exception If task threw an exception.
     */
    static <T> Poll<T> pollJoin(int runtimeId, long taskId, &Waker waker) throws Exception {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            throw new IllegalStateException("Runtime is shut down");
        }
        return engine.pollJoin(taskId, waker);
    }

    /**
     * Schedules a timer deadline on the target runtime's timer wheel.
     *
     * @param runtimeId Target runtime id.
     * @param deadline Timer expiration instant.
     * @param waker Task waker to awaken on expiration.
     * @return Timer registration identifier.
     */
    static long scheduleTimer(int runtimeId, Instant deadline, Waker waker) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            throw new IllegalStateException("Runtime is shut down");
        }
        return engine.scheduleTimer(deadline, waker);
    }

    /**
     * Registers a TCP listener with the runtime reactor.
     *
     * @param runtimeId Target runtime id.
     * @param listener Network listener.
     * @return Registration token.
     * @throws IOException If registration fails.
     */
    static int registerListener(int runtimeId, &mut TcpListener listener) throws IOException {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            throw new IllegalStateException("Runtime is shut down");
        }
        return engine.registerListener(listener);
    }

    /**
     * Registers a TCP stream with the runtime reactor.
     *
     * @param runtimeId Target runtime id.
     * @param stream Network TCP stream.
     * @param interest Poller interest mask.
     * @return Registration token.
     * @throws IOException If registration fails.
     */
    static int registerStream(int runtimeId, &mut TcpStream stream, Poller.Interest interest) throws IOException {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            throw new IllegalStateException("Runtime is shut down");
        }
        return engine.registerStream(stream, interest);
    }

    /**
     * Updates event interest for a registered stream.
     *
     * @param runtimeId Target runtime id.
     * @param stream Network TCP stream.
     * @param token Registration token.
     * @param interest Updated interest mask.
     * @throws IOException If updating fails.
     */
    static void reregisterStream(int runtimeId, &mut TcpStream stream, int token, Poller.Interest interest) throws IOException {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine != null) {
            engine.reregisterStream(stream, token, interest);
        }
    }

    /**
     * Deregisters a stream from the reactor.
     *
     * @param runtimeId Target runtime id.
     * @param stream Network TCP stream.
     * @param token Registration token.
     * @throws IOException If deregistration fails.
     */
    static void deregisterStream(int runtimeId, &mut TcpStream stream, int token) throws IOException {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine != null) {
            engine.deregisterStream(stream, token);
        }
    }

    /**
     * Deregisters a listener from the reactor.
     *
     * @param runtimeId Target runtime id.
     * @param listener Network listener.
     * @param token Registration token.
     * @throws IOException If deregistration fails.
     */
    static void deregisterListener(int runtimeId, &mut TcpListener listener, int token) throws IOException {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine != null) {
            engine.deregisterListener(listener, token);
        }
    }

    /**
     * Registers a UDP socket with the reactor.
     *
     * @param runtimeId Target runtime id.
     * @param socket UDP socket.
     * @param interest Interest mask.
     * @return Registration token.
     * @throws IOException If registration fails.
     */
    static int registerUdp(int runtimeId, &mut UdpSocket socket, Poller.Interest interest) throws IOException {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            throw new IllegalStateException("Runtime is shut down");
        }
        return engine.registerUdp(socket, interest);
    }

    /**
     * Deregisters a UDP socket from the reactor.
     *
     * @param runtimeId Target runtime id.
     * @param socket UDP socket.
     * @param token Registration token.
     * @throws IOException If deregistration fails.
     */
    static void deregisterUdp(int runtimeId, &mut UdpSocket socket, int token) throws IOException {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine != null) {
            engine.deregisterUdp(socket, token);
        }
    }

    /**
     * Registers a read waker for a reactor token.
     *
     * @param runtimeId Target runtime id.
     * @param token Registration token.
     * @param waker Task waker.
     */
    static void readWaker(int runtimeId, int token, Waker waker) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine != null) {
            engine.readWaker(token, waker);
        }
    }

    /**
     * Registers a write waker for a reactor token.
     *
     * @param runtimeId Target runtime id.
     * @param token Registration token.
     * @param waker Task waker.
     */
    static void writeWaker(int runtimeId, int token, Waker waker) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine != null) {
            engine.writeWaker(token, waker);
        }
    }

    /**
     * Checks if a descriptor is readable.
     *
     * @param runtimeId Target runtime id.
     * @param token Registration token.
     * @return {@code true} if readable.
     */
    static boolean isReadable(int runtimeId, int token) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        return engine != null && engine.isReadable(token);
    }

    /**
     * Checks if a descriptor is writable.
     *
     * @param runtimeId Target runtime id.
     * @param token Registration token.
     * @return {@code true} if writable.
     */
    static boolean isWritable(int runtimeId, int token) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        return engine != null && engine.isWritable(token);
    }

    /**
     * Clears readable flag on a descriptor.
     *
     * @param runtimeId Target runtime id.
     * @param token Registration token.
     */
    static void clearReadable(int runtimeId, int token) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine != null) {
            engine.clearReadable(token);
        }
    }

    /**
     * Clears writable flag on a descriptor.
     *
     * @param runtimeId Target runtime id.
     * @param token Registration token.
     */
    static void clearWritable(int runtimeId, int token) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine != null) {
            engine.clearWritable(token);
        }
    }

    /**
     * Takes the next ready task from the runtime run queue.
     *
     * @param runtimeId Target runtime id.
     * @param timeoutMillis Maximum wait time.
     * @return Task identifier, or 0 if timeout.
     */
    static long takeReadyTask(int runtimeId, long timeoutMillis) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            return 0L;
        }
        return engine.takeReadyTask(timeoutMillis);
    }

    /**
     * Drives a single scheduled task cooperative poll step.
     *
     * @param runtimeId Target runtime id.
     * @param taskId Task identifier.
     */
    static void pollTask(int runtimeId, long taskId) {
        Engine.Schedulable? task = null;
        {
            Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
            (&Engine)? engine = guard.get().get(&runtimeId);
            if (engine == null) {
                return;
            }
            task = engine.takeTask(taskId);
        }
        if (task == null) {
            Thread.sleep(1L);
            Runtime.wakeTask(runtimeId, taskId);
            return;
        }
        task.pollTask();
        if (task.isFinished()) {
            Exception? err = task.takeError();
            if (err != null) {
                Runtime.failTask(runtimeId, taskId, err);
            } else {
                Runtime.finishTask(runtimeId, taskId, task.takeValue());
            }
        } else if (!task.isAborted()) {
            Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
            (&Engine)? engine = guard.get().get(&runtimeId);
            if (engine != null) {
                engine.returnTask(taskId, task);
            }
        }
    }

    /**
     * Polls the timer wheel and awakens any expired timer wakers.
     *
     * @param runtimeId Target runtime id.
     * @param now Current instant.
     */
    static void pollTimers(int runtimeId, Instant now) {
        List<Waker> ready = new ArrayList<>();
        {
            Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
            (&Engine)? engine = guard.get().get(&runtimeId);
            if (engine != null) {
                ready = engine.pollTimers(now);
            }
        }
        for (int i = 0; i < ready.size(); i++) {
            &Waker w = ready.get(i);
            w.wake();
        }
    }

    /**
     * Polls the reactor for I/O readiness and awakens ready wakers.
     *
     * @param runtimeId Target runtime id.
     * @param timeoutMillis Poll timeout in milliseconds.
     * @throws IOException If polling fails.
     */
    static void pollReactor(int runtimeId, long timeoutMillis) throws IOException {
        List<Waker> ready = new ArrayList<>();
        {
            Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
            (&Engine)? engine = guard.get().get(&runtimeId);
            if (engine != null) {
                ready = engine.pollReactor(timeoutMillis);
            }
        }
        for (int i = 0; i < ready.size(); i++) {
            &Waker w = ready.get(i);
            w.wake();
        }
    }

    /**
     * Checks if the root task was awakened.
     *
     * @param runtimeId Target runtime id.
     * @return {@code true} if root task was awakened.
     */
    static boolean isRootWoken(int runtimeId) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        return engine != null && engine.isRootWoken();
    }

    /**
     * Takes and resets the root task awakened flag.
     *
     * @param runtimeId Target runtime id.
     * @return {@code true} if root task had been awakened.
     */
    static boolean takeRootWoken(int runtimeId) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        return engine != null && engine.takeRootWoken();
    }

    /**
     * Checks if the runtime has ready tasks pending in the run queue.
     *
     * @param runtimeId Target runtime id.
     * @return {@code true} if tasks are ready.
     */
    static boolean hasReadyTasks(int runtimeId) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        return engine != null && engine.hasReadyTasks();
    }

    /**
     * Returns the earliest timer deadline instant, if any.
     *
     * @param runtimeId Target runtime id.
     * @return Earliest deadline, or null.
     */
    static Instant? nextTimerDeadline(int runtimeId) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        return engine?.nextTimerDeadline();
    }

    /**
     * Checks if the runtime engine has been shut down.
     *
     * @param runtimeId Target runtime id.
     * @return {@code true} if shut down.
     */
    static boolean isShutdown(int runtimeId) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        return engine == null || engine.isShutdown();
    }

    /**
     * Takes the next blocking task runner from the blocking pool queue.
     *
     * @param runtimeId Target runtime id.
     * @return TaskRunner, or null if empty.
     */
    static BlockingPool.TaskRunner? takeBlockingTask(int runtimeId) {
        Mutex.Guard<Map<int, Engine>> guard = Runtime.ENGINES.lock();
        (&Engine)? engine = guard.get().get(&runtimeId);
        if (engine == null) {
            return null;
        }
        return engine.takeBlockingTask();
    }

    /**
     * Configuration parameters for initializing a {@link Runtime}.
     * Supports record functional update syntax via {@code with { ... }}.
     *
     * @param threads Number of asynchronous worker threads (1 for single-threaded, >1 for multi-threaded).
     * @param blockingThreads Number of dedicated blocking worker threads.
     * @param threadName Prefix string for worker thread names.
     * @param enableTimer Whether the hierarchical timer wheel driver is enabled.
     * @param enableIo Whether the reactor Poller driver is enabled.
     */
    record Config(int threads, int blockingThreads, String threadName, boolean enableTimer, boolean enableIo) {
        /**
         * Default runtime configuration: 1 worker thread, 4 blocking threads, timers and I/O enabled.
         */
        public static final Config DEFAULT = new Config(1, 4, "tide-worker", true, true);

        /**
         * Returns standard default configuration.
         *
         * @return Default Config instance.
         */
        static Config standard() {
            return Config.DEFAULT;
        }

        /**
         * Returns a multi-threaded configuration with the specified worker thread count.
         *
         * @param threads Desired number of asynchronous worker threads.
         * @return Multi-threaded Config instance.
         */
        static Config multiThread(int threads) {
            return new Config(threads, 4, "tide-worker", true, true);
        }
    }
}
